{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/*.{js,jsx}",
    "src/components/**/*.{js,jsx}",
    "src/lib/**/*.{js,jsx}",
    "src/hooks/**/*.{js,jsx}",
    "src/contexts/**/*.{js,jsx}",
    "src/paths.js",
    "src/config.js",
    "src/styles/**/*.{js,jsx}"
  ],
  "project": [
    "src/**/*.{js,jsx}"
  ],
  "ignore": [
    "src/schemas/generated/**"
  ],
  "ignoreDependencies": [],
  "ignoreExportsUsedInFile": true
}
